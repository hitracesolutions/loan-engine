# ============================================
# Cloudflare Bindings (Auto-filled by Wrangler)
# ============================================
# DB=gidfine-db
# R2=gidfine-documents
# CACHE=CACHE
# QUEUE=gidfine-notifications

# ============================================
# Environment
# ============================================
ENVIRONMENT=development

# ============================================
# Frontend
# ============================================
VITE_API_URL=http://localhost:8787
VITE_ENVIRONMENT=development

# ============================================
# Secrets (Set via `wrangler secret put`)
# ============================================
# JWT_SECRET=your_random_secret_here
# SENDGRID_API_KEY=your_sendgrid_key
# TWILIO_API_KEY=your_twilio_key

# ============================================
# Initial Admin User (Set on first deployment)
# ============================================
# 
#
# On first deployment, these credentials create a staff_users record
# with role=PLATFORM_ADMIN. After login, change the password immediately.
#
# Set via: wrangler secret put ADMIN_EMAIL
#          wrangler secret put ADMIN_PASSWORD
#
# Or pass as environment variables in wrangler.toml:
# [env.development]
#   vars = { ADMIN_EMAIL = "admin@dev.gidfine.com" }

# ============================================
# Database
# ============================================
# DATABASE_URL is auto-configured by Wrangler

# ============================================
# Notes
# ============================================
# DO NOT edit this file to add real secrets!
# Use `wrangler secret put NAME` instead
# This file is for documentation only
